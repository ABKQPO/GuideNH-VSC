{
  "name": "guide-vsc",
  "displayName": "GuideVSC",
  "description": "GuideNH VSC",
  "version": "0.0.1",
  "license": "LGPL-3.0-only",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:guidenh-md",
    "onCommand:guide-vsc.generateSchema",
    "onCommand:guide-vsc.connectRuntimeBridge",
    "onCommand:guide-vsc.disconnectRuntimeBridge"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "guidenh-md",
        "aliases": [
          "GuideNH Markdown",
          "guidenh-md"
        ],
        "extensions": [
          ".guidenh.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "GuideNH",
      "properties": {
        "guide-vsc.guideNhSourcePath": {
          "type": "string",
          "default": "E:\\\\Github\\\\GuideNH",
          "description": "Path to the GuideNH source repository used by schema generation."
        },
        "guide-vsc.runtimeBridge.host": {
          "type": "string",
          "default": "",
          "description": "GuideNH runtime bridge host. No default is provided for safety."
        },
        "guide-vsc.runtimeBridge.port": {
          "type": "number",
          "default": 0,
          "description": "GuideNH runtime bridge port. No default is provided for safety."
        },
        "guide-vsc.runtimeBridge.token": {
          "type": "string",
          "default": "",
          "description": "GuideNH runtime bridge token. No default is provided for safety."
        }
      }
    },
    "commands": [
      {
        "command": "guide-vsc.generateSchema",
        "title": "GuideNH: Generate Schema"
      },
      {
        "command": "guide-vsc.connectRuntimeBridge",
        "title": "GuideNH: Connect Runtime Bridge"
      },
      {
        "command": "guide-vsc.disconnectRuntimeBridge",
        "title": "GuideNH: Disconnect Runtime Bridge"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "node ./out/scripts/bundle.js",
    "generate:schema": "node ./out/scripts/generateSchema.js",
    "verify:e2e": "node ./out/scripts/verifyE2e.js",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "verify": "npm run generate:schema && npm run lint && npm run compile && npm test",
    "prepackage": "npm run compile && npm run bundle",
    "package": "vsce package --out dist/guide-vsc.vsix",
    "build": "npm run verify && npm run package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@types/ws": "^8.5.13",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
