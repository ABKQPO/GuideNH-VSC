{
  "name": "guide-vsc",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "icon": "logo.png",
  "version": "0.0.1",
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ABKQPO/GuideNH-VSC.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:guidenh-md",
    "onCommand:guide-vsc.generateSchema",
    "onCommand:guide-vsc.connectRuntimeBridge",
    "onCommand:guide-vsc.disconnectRuntimeBridge",
    "onCommand:guide-vsc.validateRuntimeDocument",
    "onCommand:guide-vsc.pickItemStack"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "guidenh-md",
        "aliases": [
          "GuideNH Markdown",
          "guidenh-md"
        ],
        "extensions": [
          ".guidenh.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "guidenh.mdx.injection",
        "path": "./syntaxes/guidenh-mdx.tmLanguage.json",
        "injectTo": [
          "text.html.markdown",
          "source.gfm"
        ]
      }
    ],
    "markdown.previewStyles": [
      "./media/guidenh-markdown-preview.css"
    ],
    "markdown.previewScripts": [
      "./media/guidenh-markdown-preview.js"
    ],
    "markdown.markdownItPlugins": true,
    "configuration": {
      "title": "GuideNH",
      "properties": {
        "guide-vsc.guideNhSourcePath": {
          "type": "string",
          "default": "E:\\Github\\GuideNH",
          "description": "%configuration.guideNhSourcePath.description%"
        },
        "guide-vsc.resourcePackPath": {
          "type": "string",
          "default": "E:\\Github\\GuideNH\\wiki\\resourcepack",
          "description": "%configuration.resourcePackPath.description%"
        },
        "guide-vsc.runtimeBridge.host": {
          "type": "string",
          "default": "",
          "description": "%configuration.runtimeBridge.host.description%"
        },
        "guide-vsc.runtimeBridge.port": {
          "type": "number",
          "default": 0,
          "description": "%configuration.runtimeBridge.port.description%"
        },
        "guide-vsc.runtimeBridge.token": {
          "type": "string",
          "default": "",
          "description": "%configuration.runtimeBridge.token.description%"
        },
        "guide-vsc.runtimeBridge.allowRemote": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.runtimeBridge.allowRemote.description%"
        },
        "guide-vsc.runtimeBridge.autoConnectOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.runtimeBridge.autoConnectOnStartup.description%"
        }
      }
    },
    "commands": [
      {
        "command": "guide-vsc.generateSchema",
        "title": "%command.generateSchema.title%"
      },
      {
        "command": "guide-vsc.connectRuntimeBridge",
        "title": "%command.connectRuntimeBridge.title%"
      },
      {
        "command": "guide-vsc.disconnectRuntimeBridge",
        "title": "%command.disconnectRuntimeBridge.title%"
      },
      {
        "command": "guide-vsc.validateRuntimeDocument",
        "title": "%command.validateRuntimeDocument.title%"
      },
      {
        "command": "guide-vsc.pickItemStack",
        "title": "%command.pickItemStack.title%"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "node ./out/scripts/bundle.js",
    "generate:schema": "npm run compile && node ./out/scripts/generateSchema.js",
    "verify:e2e": "node ./out/scripts/verifyE2e.js",
    "verify:runtime-bridge-live": "node ./out/scripts/verifyRuntimeBridgeLive.js",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "verify": "npm run generate:schema && npm run lint && npm run compile && npm test",
    "prepackage": "npm run compile && npm run bundle",
    "package": "node -e \"require('fs').mkdirSync('dist', { recursive: true })\" && vsce package --out dist/guide-vsc.vsix",
    "build": "npm run verify && npm run package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@types/ws": "^8.5.13",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
