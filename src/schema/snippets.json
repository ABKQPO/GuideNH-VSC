{
  "schemaVersion": 1,
  "snippets": {
    "guidenh.gameScene": {
      "prefix": "GameScene",
      "body": [
        "<GameScene width=\"${1:220}\" height=\"${2:150}\" interactive={${3:true}}>",
        "  <Block id=\"${4:minecraft:stone}\" />",
        "</GameScene>"
      ],
      "description": "Insert a GuideNH GameScene."
    },
    "guidenh.block": {
      "prefix": "Block",
      "body": ["<Block id=\"${1:minecraft:stone}\" />"],
      "description": "Insert a scene block."
    },
    "guidenh.importStructure": {
      "prefix": "ImportStructure",
      "body": ["<ImportStructure src=\"${1:./structure.snbt}\" />"],
      "description": "Import a structure into a GameScene."
    },
    "guidenh.itemLink": {
      "prefix": "ItemLink",
      "body": ["<ItemLink id=\"${1:minecraft:diamond}\" />"],
      "description": "Insert an item link."
    },
    "guidenh.recipe": {
      "prefix": "Recipe",
      "body": ["<Recipe id=\"${1:minecraft:stone}\" />"],
      "description": "Insert a recipe."
    }
  }
}
