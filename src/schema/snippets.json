{
  "schemaVersion": 1,
  "snippets": {
    "guidenh.gameScene": {
      "prefix": "GameScene",
      "body": [
        "<GameScene width=\"${1:220}\" height=\"${2:150}\" interactive={${3:true}}>",
        "  <Block id=\"${4:minecraft:stone}\" />",
        "</GameScene>"
      ],
      "description": "Insert a GuideNH GameScene."
    },
    "guidenh.block": {
      "prefix": "Block",
      "body": [
        "<Block id=\"${1:minecraft:stone}\" />"
      ],
      "description": "Insert a scene block."
    },
    "guidenh.importStructure": {
      "prefix": "ImportStructure",
      "body": [
        "<ImportStructure src=\"${1:./structure.snbt}\" />"
      ],
      "description": "Import a structure into a GameScene."
    },
    "guidenh.importStructureLib": {
      "prefix": "ImportStructureLib",
      "body": [
        "<ImportStructureLib controller=\"${1:gregtech:gt.blockmachines:2741}\"${2: formed={true}} />"
      ],
      "description": "Insert a StructureLib scene import."
    },
    "guidenh.gtBlock": {
      "prefix": "GTBlock",
      "body": [
        "<Block id=\"${1:gregtech:gt.blockmachines:2741}\"${2: formed={true}} />"
      ],
      "description": "Insert a GT controller scene block."
    },
    "guidenh.itemLink": {
      "prefix": "ItemLink",
      "body": [
        "<ItemLink id=\"${1:minecraft:diamond}\" />"
      ],
      "description": "Insert an item link."
    },
    "guidenh.recipe": {
      "prefix": "Recipe",
      "body": [
        "<Recipe id=\"${1:minecraft:stone}\" />"
      ],
      "description": "Insert a recipe."
    },
    "guidenh.inputAnnotation": {
      "prefix": "InputAnnotation",
      "body": [
        "<InputAnnotation pos=\"$00.5 1.5 0.5\" inputType=\"lmb\" />"
      ],
      "description": "Insert a <InputAnnotation> tag."
    },
    "guidenh.blockStats": {
      "prefix": "BlockStats",
      "body": [
        "<BlockStats corner=\"topRight\">",
        "  $0",
        "</BlockStats>"
      ],
      "description": "Insert a <BlockStats> tag."
    },
    "guidenh.columnChart": {
      "prefix": "ColumnChart",
      "body": [
        "<ColumnChart title=\"$0Total\" width=\"360\" height=\"220\">",
        "  <Series name=\"A\" data=\"1 2 3\" />",
        "</ColumnChart>"
      ],
      "description": "Insert a <ColumnChart> tag."
    },
    "guidenh.lineChart": {
      "prefix": "LineChart",
      "body": [
        "<LineChart title=\"$0Trend\" width=\"360\" height=\"220\">",
        "  <Series name=\"A\" data=\"1 2 3\" />",
        "</LineChart>"
      ],
      "description": "Insert a <LineChart> tag."
    },
    "guidenh.functionGraph": {
      "prefix": "FunctionGraph",
      "body": [
        "<FunctionGraph width=\"360\" height=\"220\" xRange=\"-6..6\" yRange=\"-3..3\">",
        "  <Plot expr=\"$0sin(x)\" color=\"#ff5566\" />",
        "</FunctionGraph>"
      ],
      "description": "Insert a <FunctionGraph> tag."
    },
    "guidenh.blockStat": {
      "prefix": "BlockStat",
      "body": [
        "<BlockStat item=\"$0\" count=\"1\" />"
      ],
      "description": "Insert a <BlockStat> tag."
    },
    "guidenh.barChart": {
      "prefix": "BarChart",
      "body": [
        "<BarChart title=\"$0Total\" width=\"360\" height=\"220\">",
        "  <Series name=\"A\" data=\"1 2 3\" />",
        "</BarChart>"
      ],
      "description": "Insert a <BarChart> tag."
    },
    "guidenh.pieChart": {
      "prefix": "PieChart",
      "body": [
        "<PieChart title=\"$0Share\" width=\"320\" height=\"220\">",
        "  <Slice name=\"A\" value=\"1\" />",
        "</PieChart>"
      ],
      "description": "Insert a <PieChart> tag."
    }
